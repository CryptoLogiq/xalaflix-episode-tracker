{
  "manifest_version": 3,
  "name": "Xalaflix Episode Tracker",
  "version": "1.0",
  "description": "Suivi automatique des épisodes vus sur Xalaflix",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "*://*/shows/*",
    "*://*/movies/*"
  ],

  "action": {
    "default_title": "Debug",
    "default_popup": "debug.html"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*/shows/*",
        "*://*/movies/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
